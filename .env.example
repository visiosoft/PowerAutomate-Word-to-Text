# Server
PORT=3500

# DeepSeek AI (for /api/compare)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Local MSSQL Database (for section content persistence)
# Option A: SQL Server (TCP/IP)
# DB_SERVER=localhost
# DB_PORT=1433
# DB_USER=SA
# DB_PASSWORD=your_sa_password

# Option B: LocalDB with SQL Server Auth (sa user)
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=WordToHTMLX
DB_USER=sa
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_SERVER=true
DB_CONNECT_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT=30000
